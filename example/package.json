{
  "name": "ceves-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal Cloudflare Worker showing the Ceves event-sourcing library end-to-end.",
  "scripts": {
    "gen:decorator-imports": "ceves-generate-imports --pattern '{commands,queries,events}/*.ts'",
    "predev": "npm run gen:decorator-imports",
    "prebuild": "npm run gen:decorator-imports",
    "predeploy": "npm run gen:decorator-imports",
    "pretest": "npm run gen:decorator-imports",
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "prenats:build": "npm run gen:decorator-imports",
    "nats:build": "esbuild src/nats-main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-nats/main.mjs",
    "prenats:start": "npm run nats:build",
    "nats:start": "node --import ./scripts/register-cf-shim.mjs dist-nats/main.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pregen:pg": "npm run gen:decorator-imports",
    "gen:pg": "ceves-generate-pg --entry src/pg-entry.ts --out ceves-pg.sql --manifest ceves-pg.manifest.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/kv": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@sydorenkoalex/ceves": "file:..",
    "ceves": "file:..",
    "hono": "^4.10.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251213.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.8",
    "wrangler": "^3.95.0"
  }
}
