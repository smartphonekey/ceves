{
  "name": "@sydorenkoalex/ceves",
  "version": "0.4.0",
  "description": "Event Sourcing framework for Cloudflare Workers (Durable Objects + R2), AWS Lambda, NATS, and PostgreSQL (PLV8) \u2014 CQRS with decorator routes and OpenAPI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./aws": {
      "types": "./dist/adapters/aws/index.d.ts",
      "import": "./dist/adapters/aws/index.js"
    },
    "./nats": {
      "types": "./dist/adapters/nats/index.d.ts",
      "import": "./dist/adapters/nats/index.js"
    },
    "./nats/cloudflare-workers-shim": {
      "types": "./dist/adapters/nats/cloudflare-workers-shim.d.ts",
      "import": "./dist/adapters/nats/cloudflare-workers-shim.js"
    },
    "./pg": {
      "types": "./dist/adapters/pg/index.d.ts",
      "import": "./dist/adapters/pg/index.js"
    }
  },
  "bin": {
    "ceves-generate-imports": "./bin/generate-decorator-imports.mjs",
    "ceves-generate-pg": "./bin/generate-pg.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/adr",
    "docs/architecture",
    "example/src",
    "example/README.md",
    "example/wrangler.toml",
    "example/tsconfig.json",
    "example/package.json",
    "example/scripts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write src",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "prepack": "npm run build"
  },
  "keywords": [
    "event-sourcing",
    "cqrs",
    "cloudflare-workers",
    "durable-objects",
    "aws-lambda",
    "nats",
    "jetstream",
    "typescript",
    "r2",
    "s3",
    "serverless",
    "multi-cloud",
    "event-store",
    "openapi",
    "postgresql",
    "plv8",
    "transactional-outbox"
  ],
  "author": "Alex Sydorenko",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexsyd/ceves.git"
  },
  "homepage": "https://github.com/alexsyd/ceves#readme",
  "bugs": {
    "url": "https://github.com/alexsyd/ceves/issues"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@cloudflare/vitest-pool-workers": "^0.10.7",
    "@cloudflare/workers-types": "4.20251213.0",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/kv": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@types/aws-lambda": "^8.10.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "chanfana": "^3.3.0",
    "jose": "^5.0.0",
    "tinyglobby": "^0.2.16",
    "zod": "^4.4.3",
    "hono": "^4.10.6"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/kv": "^3.4.0",
    "@types/aws-lambda": "^8.10.0",
    "typescript": ">=5.0.0",
    "@cloudflare/workers-types": ">=4.20251213.0",
    "esbuild": ">=0.20.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@nats-io/jetstream": {
      "optional": true
    },
    "@nats-io/kv": {
      "optional": true
    },
    "@types/aws-lambda": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "@cloudflare/workers-types": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    }
  }
}
